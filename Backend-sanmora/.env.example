# Server Port
PORT=5000

# Hostinger SMTP Configuration
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=your_email@domain.com
EMAIL_PASS=your_hostinger_email_password
EMAIL_RECEIVER=info@sanmora.in, info@sanmora.co.za

# Google reCAPTCHA v3 Secret Key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Allowed CORS Origins (comma-separated for production)
ALLOWED_ORIGINS=https://sanmora.in,https://www.sanmora.in,http://localhost:3000

